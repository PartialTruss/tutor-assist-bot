# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
TEACHER_CHAT_ID=123456789
SENDER_NAME=Your Name

# Appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_STUDENTS_COLLECTION_ID=students

# Cron (optional overrides)
# Student reminders: daily at 12:00 PM
STUDENT_REMINDER_CRON=0 12 * * *
# Teacher reminder: daily at 9:00 AM
TEACHER_REMINDER_CRON=0 9 * * *
# IANA timezone for cron schedules
TZ=Asia/Tehran
